# Copy to .env (or export these variables) before starting the API.
# Spring Boot reads them through the ${VAR:default} placeholders in
# src/main/resources/application.properties.

# HTTP port. Change this if something else already listens on 8080.
PORT=8080

# Comma-separated origins allowed to call the API from a browser.
CLIENT_ORIGIN=http://localhost:5173

# HMAC key used to sign JWTs. Use a long random value in production.
JWT_SECRET=dev-only-secret-change-me-please-32bytes-min

# Directory holding mobilenetv2-12.onnx, yamnet.onnx and imagenet-synset.txt.
# Populate it with: powershell -File scripts/fetch-models.ps1
ML_MODEL_DIR=models
